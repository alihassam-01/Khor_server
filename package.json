{
  "name": "server",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\"",
    "dev": "nodemon --watch src --ext ts --exec ts-node -r tsconfig-paths/register src/index.ts",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "npm run clean && tsc && tsc-alias",
    "postinstall": "npm run build",
    "test": "node -r ts-node/register/transpile-only -r tsconfig-paths/register --test \"tests/**/*.test.ts\"",
    "typeorm": "node -r ts-node/register/transpile-only -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/ormconfig.cli.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/ormconfig.cli.ts",
    "migration:run:dist": "node ./node_modules/typeorm/cli.js migration:run -d dist/config/ormconfig.cli.js",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/ormconfig.cli.ts",
    "migration:show": "npm run typeorm -- migration:show -d src/config/ormconfig.cli.ts",
    "seed:locations": "ts-node -r tsconfig-paths/register src/scripts/seed-locations.ts",
    "seed:articles": "ts-node -r tsconfig-paths/register src/scripts/seed-articles.ts",
    "seed:all": "ts-node -r tsconfig-paths/register src/scripts/seed-locations.ts && ts-node -r tsconfig-paths/register src/scripts/seed-articles.ts",
    "migrate:legacy": "ts-node -r tsconfig-paths/register src/scripts/migrate-legacy-data.ts",
    "backfill:business-onboarding": "ts-node -r tsconfig-paths/register src/scripts/backfill-business-onboarding.ts"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@aws-sdk/s3-request-presigner": "^3.937.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/postgres": "^6.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sfpy/node-core": "^0.3.5",
    "axios": "^1.19.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "fastify-raw-body": "^5.0.0",
    "google-auth-library": "^10.7.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.5",
    "pg": "^8.15.6",
    "puppeteer": "^24.20.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.3",
    "sharp": "^0.32.0",
    "typeorm": "^0.3.22",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/fastify-multipart": "^0.7.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.0",
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "tar": "^7.5.13",
    "@mapbox/node-pre-gyp": "^2.0.3"
  }
}
